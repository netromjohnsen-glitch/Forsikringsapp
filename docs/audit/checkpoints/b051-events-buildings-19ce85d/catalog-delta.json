    {
      "owner": "gjensidigeHusPluss",
      "key": "hus.takvegg.folgeskade",
      "before": {
        "key": "hus.takvegg.folgeskade",
        "label": "Vann gjennom tak og yttervegg",
        "value": "Følgeskade ved vanninntrengning gjennom utett bygning over bakkenivå. Selve feilen/utettheten og tak eldre enn 50 år er unntatt; bygningen må være fullverdiforsikret.",
        "replacesBase": true,
        "source": {
          "documentId": "gjensidigeHusPluss",
